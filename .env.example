# Copy to .env (repo root) for docker compose, and/or to backend/.env for running the backend directly.
# Never commit .env. Generate secrets with:  cd backend && python -m app.cli generate-keys

# --- Database (docker compose) ---
POSTGRES_DB=attendops
POSTGRES_USER=attendops
POSTGRES_PASSWORD=change-me

# --- Backend ---
# SQLAlchemy URL. Docker compose builds this itself from the POSTGRES_* values above;
# set it only when running the backend outside docker.
DATABASE_URL=postgresql+psycopg://attendops:change-me@localhost:5432/attendops

# Signs JWTs. Required, at least 32 characters. Changing it signs everyone out.
JWT_SECRET=

# Fernet key that encrypts device passwords at rest. Required.
# Back it up: if it is lost, every stored device password must be re-entered.
DEVICE_CREDENTIALS_KEY=

# development | production  (production: secure cookies, API docs disabled)
ENVIRONMENT=development

# Time zone used to display times (all times are stored in UTC).
APP_TIMEZONE=Asia/Beirut

# Device communication. The terminals accept only a few simultaneous connections, and
# dahua_attendance_logger.py polls the same devices, so keep concurrency low.
DEVICE_CONNECT_TIMEOUT=3
DEVICE_READ_TIMEOUT=10
DEVICE_MAX_CONCURRENCY=4

LOG_LEVEL=INFO

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Browser origins allowed to call the API directly (JSON list). Not needed when using the Vite proxy.
CORS_ORIGINS=["http://localhost:5173"]
